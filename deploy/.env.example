# Copy this file to .env in the same folder (deploy/.env) and fill in real values
# before running `docker compose up`. Never commit the real .env file.

DB_ROOT_PASSWORD=changeme
DB_USERNAME=lifetag_user
DB_PASSWORD=changeme

# Generate a strong random value, e.g.:  openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32

# Comma-separated list of origins allowed to call the API directly (only relevant
# if something other than the bundled nginx frontend calls the backend cross-origin).
ALLOWED_ORIGINS=http://localhost

# ---- First administrator (REQUIRED on the first start against an empty database) ----
# There are no built-in logins. These create the first ADMIN; sign in with them, then
# create everyone else from Staff Management and DELETE BOOTSTRAP_ADMIN_PASSWORD from .env.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password-min-8-chars
BOOTSTRAP_ADMIN_EMAIL=admin@your-hospital.example
BOOTSTRAP_ADMIN_FULL_NAME=Hospital Administrator
